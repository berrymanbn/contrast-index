---
import Base from '../../layouts/Base.astro';
const guides = [
  { href: '/cold-plunges/chillers/', title: 'Cold plunge chillers compared', text: 'Horsepower, coldest temperature and tub size for every chiller system in the index.' },
  { href: '/guides/infrared-vs-traditional-sauna/', title: 'Infrared vs traditional sauna', text: 'Temperature, power, heat-up time and price, side by side.' },
  { href: '/guides/sauna-electrical-requirements/', title: 'Sauna electrical requirements', text: 'Which saunas plug into a standard outlet, and which need a new circuit.' },
  { href: '/best-cold-plunge/', title: 'Best cold plunge', text: 'Picks for each need, chosen by stated rules applied to published specs.' },
  { href: '/best-home-sauna/', title: 'Best home sauna', text: 'Picks for each need, chosen by stated rules applied to published specs.' },
  { href: '/saunas/indoor/', title: 'Indoor saunas for home', text: 'Ceiling heights, footprints and power for every indoor model.' },
  { href: '/saunas/2-person-sauna-dimensions/', title: '2 person sauna dimensions', text: 'Exact exterior sizes, smallest footprint first.' },
  { href: '/cold-plunges/cost/', title: 'Cold plunge cost', text: 'Purchase prices by type, plus an electricity cost calculator.' },
  { href: '/guides/cold-plunge-vs-ice-bath/', title: 'Cold plunge vs ice bath', text: 'Temperature, cost and upkeep compared.' },
  { href: '/tools/sauna-heater-size-calculator/', title: 'Sauna heater size calculator', text: 'Estimate the heater kW your room needs.' },
];
---
<Base title="Sauna and Cold Plunge Buying Guides" description="Buying guides built from manufacturer specs: chiller comparisons, infrared vs traditional saunas, and electrical requirements.">
  <div class="wrap page-head">
    <h1>Guides</h1>
    <p class="lead">Guides and calculators built from the specs in the index, so the numbers update when the data does.</p>
  </div>
  <div class="wrap">
    <ul class="guide-list">
      {guides.map((g) => <li><a href={g.href}>{g.title}</a><p>{g.text}</p></li>)}
    </ul>
  </div>
</Base>
