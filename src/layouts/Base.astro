---
interface Props {
  title: string;
  description: string;
  schema?: object | object[];
}
const { title, description, schema } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = Astro.url.pathname === '/' ? title : `${title} | The Contrast Index`;
const nav = [
  { href: '/cold-plunges/', label: 'Cold plunges' },
  { href: '/saunas/', label: 'Saunas' },
  { href: '/guides/', label: 'Guides' },
  { href: '/how-we-rate/', label: 'How we rate' },
];
const here = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/archivo-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/styles.css" />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <script is:inline>
      // GA4 (G-XZ9MZ4SKQ2). Loads only on the live domain, so preview and
      // pages.dev traffic never reaches the property.
      (function () {
        var ID = 'G-XZ9MZ4SKQ2';
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { dataLayer.push(arguments); };
        if (location.hostname !== 'contrastindex.com') return;
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ID;
        document.head.appendChild(s);
        gtag('js', new Date());
        gtag('config', ID);
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="wordmark" href="/" aria-label="The Contrast Index home">
          <span class="wm-the">The</span>
          <span class="wm-name">Contrast Index</span>
        </a>
        <nav aria-label="Main">
          <ul>
            {nav.map((n) => (
              <li><a href={n.href} aria-current={here.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <p class="footer-name">The Contrast Index</p>
        <p>Sauna and cold plunge specs, taken from each manufacturer and dated. Some links may earn us a commission at no cost to you; it never affects which products we list or how we order them. <a href="/how-we-rate/">How we rate</a>.</p>
        <p class="muted">Specs and prices change. Always confirm with the manufacturer before you buy.</p>
        <p class="muted"><a href="/privacy/">Privacy policy</a></p>
      </div>
    </footer>
    <script is:inline>
      // Sends a GA4 brand_click event for every link marked data-track="brand_click".
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[data-track="brand_click"]');
        if (!a || typeof gtag !== 'function') return;
        gtag('event', 'brand_click', {
          brand: a.dataset.brand,
          model: a.dataset.model,
          product_type: a.dataset.productType,
          page_type: a.dataset.pageType,
          link_location: a.dataset.linkLocation,
          link_url: a.href,
          transport_type: 'beacon'
        });
      });
    </script>
  </body>
</html>
