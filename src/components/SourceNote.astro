---
interface Props { source: string; checked: string; brand: string }
const { source, checked, brand } = Astro.props;
const date = new Date(checked + 'T12:00:00').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---
<p class="source-note">
  Specs from <a href={source} rel="nofollow noopener" target="_blank">{brand}'s published page</a>, checked {date}.
  Anything marked "Not published" isn't stated by {brand}; we don't estimate it.
</p>
